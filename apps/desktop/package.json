{
  "name": "@oneworks/desktop",
  "version": "1.0.0-rc.3",
  "private": true,
  "description": "One Works desktop shell",
  "author": "One Works contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneworks-ai/app.git"
  },
  "oneworks": {
    "release": {
      "macosSigningPolicy": "unsigned"
    }
  },
  "main": "./dist/main/index.js",
  "scripts": {
    "build:electron": "electron-vite build --config electron.vite.config.ts --outDir dist --ignoreConfigWarning",
    "build:client": "pnpm -C ../client exec vite build",
    "build:plugins": "pnpm --filter @oneworks/plugin-channel-oneworks --filter @oneworks/plugin-external-browser-driver --filter @oneworks/plugin-cua-driver --filter @oneworks/plugin-relay build",
    "build:server": "pnpm -C ../server build:runtime",
    "dev": "pnpm run build:electron && electron .",
    "icons:sync": "node ./scripts/sync-icons.cjs",
    "make": "pnpm run package && node ./scripts/make.cjs",
    "make:pkg": "pnpm run package && node ./scripts/make.cjs --target pkg",
    "make:pkg:icon": "pnpm run package:icon && node ./scripts/make.cjs --target pkg --mac-icon icon",
    "make:pkg:from-package": "node ./scripts/make.cjs --target pkg",
    "make:pkg:icon:from-package": "node ./scripts/make.cjs --target pkg --mac-icon icon",
    "make:from-package": "node ./scripts/make.cjs",
    "mock:update-feed": "node ./scripts/mock-update-feed.cjs",
    "package": "pnpm run build:plugins && pnpm run build:client && pnpm run build:server && pnpm run build:electron && node ./scripts/package.cjs",
    "package:icon": "node ./scripts/package.cjs --mac-icon icon --check-icons && pnpm run build:plugins && pnpm run build:client && pnpm run build:server && pnpm run build:electron && node ./scripts/package.cjs --mac-icon icon",
    "smoke:package": "node ./scripts/smoke-packaged-server.cjs",
    "verify:macos-install": "node ./scripts/verify-macos-install.cjs",
    "test": "pnpm -C ../.. exec vitest run --workspace vitest.workspace.ts --project node apps/desktop/__tests__",
    "test:package-preflight": "node ../../scripts/run-workspace-check.mjs --require-bin vitest -- pnpm -C ../.. exec vitest run --workspace vitest.workspace.ts --project node apps/desktop/__tests__/builtin-adapter-cache.spec.ts apps/desktop/__tests__/desktop-package-version.spec.ts apps/desktop/__tests__/mac-adhoc-seal.spec.ts apps/desktop/__tests__/mac-signing-options.spec.ts apps/desktop/__tests__/notarization-state.spec.ts apps/desktop/__tests__/notarize-artifacts.spec.ts apps/desktop/__tests__/osx-sign-walk.spec.ts apps/desktop/__tests__/release-candidate-manifest.spec.ts apps/desktop/__tests__/runtime-consumer-cli-path.spec.ts apps/desktop/__tests__/smoke-packaged-server.spec.ts apps/desktop/__tests__/verify-macos-adhoc-artifacts.spec.ts apps/desktop/__tests__/verify-macos-signed-apps.spec.ts scripts/__tests__/desktop-package-workflow.spec.ts scripts/__tests__/workspace-dependency-bootstrap.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@oneworks/adapter-claude-code": "workspace:*",
    "@oneworks/adapter-cline": "workspace:*",
    "@oneworks/adapter-codex": "workspace:*",
    "@oneworks/adapter-copilot": "workspace:*",
    "@oneworks/adapter-cursor": "workspace:*",
    "@oneworks/adapter-droid": "workspace:*",
    "@oneworks/adapter-dsh": "workspace:*",
    "@oneworks/adapter-gemini": "workspace:*",
    "@oneworks/adapter-goose": "workspace:*",
    "@oneworks/adapter-grok": "workspace:*",
    "@oneworks/adapter-junie": "workspace:*",
    "@oneworks/adapter-kimi": "workspace:*",
    "@oneworks/adapter-kiro": "workspace:*",
    "@oneworks/adapter-opencode": "workspace:*",
    "@oneworks/adapter-pi": "workspace:*",
    "@oneworks/adapter-qwen-code": "workspace:*",
    "@oneworks/channel-oneworks": "workspace:*",
    "@oneworks/cli": "workspace:*",
    "@oneworks/cli-helper": "workspace:*",
    "@oneworks/config": "workspace:*",
    "@oneworks/cursor": "workspace:*",
    "@oneworks/diagnostics": "workspace:*",
    "@oneworks/icon": "workspace:*",
    "@oneworks/plugin-browser-driver": "workspace:*",
    "@oneworks/plugin-channel-oneworks": "workspace:*",
    "@oneworks/plugin-cua-driver": "workspace:*",
    "@oneworks/plugin-external-browser-driver": "workspace:*",
    "@oneworks/plugin-logger": "workspace:*",
    "@oneworks/plugin-relay": "workspace:*",
    "@oneworks/register": "workspace:*",
    "@oneworks/server": "workspace:*",
    "@oneworks/types": "workspace:*",
    "@oneworks/utils": "workspace:*",
    "@yume-chan/adb": "2.6.0",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/adb-server-node-tcp": "2.5.2",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/stream-extra": "2.6.1",
    "electron-updater": "^6.8.9",
    "oneworks": "workspace:*"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/packager": "^19.1.0",
    "@swc/core": "^1.0.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "vite": "^5.4.8"
  }
}
