{
  "name": "@oneworks/fs-authority-native",
  "version": "1.0.0-rc.1",
  "description": "Fail-closed native filesystem authority for One Works",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oneworks-ai/app.git",
    "directory": "packages/fs-authority-native"
  },
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.cjs" },
    "./testing": { "types": "./testing.d.ts", "default": "./testing.cjs" },
    "./package.json": "./package.json"
  },
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "files": ["*.cjs", "*.d.ts", "prebuilds/**/*.node", "prebuilds/manifest.json"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build:native": "node ./scripts/build.mjs --arch arm64 && node ./scripts/build.mjs --arch x64",
    "test:native": "node --test --test-timeout=30000 ./__tests__/*.test.cjs",
    "verify:source": "node ./scripts/verify-posix-source.mjs",
    "verify:prebuilds": "node ./scripts/verify-darwin-prebuilds.mjs"
  }
}
