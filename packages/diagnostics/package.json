{
  "name": "@oneworks/diagnostics",
  "version": "1.0.0-rc.4",
  "description": "Shared diagnostic facts and operation lifecycle for One Works",
  "repository": {
    "type": "git",
    "url": "https://github.com/oneworks-ai/app.git",
    "directory": "packages/diagnostics"
  },
  "imports": {
    "#~/*.js": {
      "__oneworks__": {
        "default": "./src/*.ts"
      },
      "default": {
        "import": "./dist/*.mjs",
        "require": "./dist/*.js"
      }
    }
  },
  "exports": {
    ".": {
      "__oneworks__": {
        "default": "./src/index.ts"
      },
      "default": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "./node": {
      "__oneworks__": {
        "default": "./src/node.ts"
      },
      "default": {
        "import": "./dist/node.mjs",
        "require": "./dist/node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "pnpm -C ../.. exec vitest run --workspace vitest.workspace.ts --project bundler packages/diagnostics/__tests__"
  }
}
